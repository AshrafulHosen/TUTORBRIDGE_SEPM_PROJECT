# Database
DB_NAME=tutorbridge
DB_USER=tutorbridge
DB_PASSWORD=change-me-db-password
DB_URL=jdbc:postgresql://db:5432/tutorbridge

# Application
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Security (JWT secret must be at least 32 characters / 256 bits)
JWT_SECRET=change-me-to-a-random-secret-at-least-32-bytes

# Seeded Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Monitoring (used when running with --profile monitoring)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
